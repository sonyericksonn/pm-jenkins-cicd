pipeline {
    agent any

    stages {
        stage('init') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.9.8'
                    args '--entrypoint=""'
                }
            }
            steps {
                dir(/home/russo/Lab/proxmox) {
                    sh '''
                      terraform init -no-color
                    '''
                }
            }
        } 
    }  
}
