pipeline {
    agent any

    environment {
        PM_API_TOKEN_ID     = credentials('pm-api-token-id')
        PM_API_TOKEN_SECRET = credentials('pm-api-token-secret')
        AWS_ACCESS_KEY_ID   = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        JENKINS_PUB_KEY     = credentials('jenkins-pub-key')
    }

    stages {
        stage('Authentication') {
            agent {
                docker {
                    image 'alpine'
                }
            }
            steps {
                dir('terraform') {
                    withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-private-key', keyFileVariable: 'JENKINS_PRIVATE_KEY')]) {
                        sh '''
                            cp "$JENKINS_PRIVATE_KEY" id_rsa
                            echo "$JENKINS_PUB_KEY" > id_rsa.pub
                            
                        '''
                    }
                }
            } // <- Esta chave do 'steps' estava faltando
        }   
        
        stage('Init') {
            agent {
                docker {
                    image 'alpine'
                    
                }
            }
            steps {
                dir('terraform') {
                    sh 'terraform init -no-color'
                }
            }
        }   
        
        stage('Plan') {
            agent {
                docker {
                    image 'alpine'
                    
                }
            }
            steps {
                dir('terraform') {
                    sh 'terraform plan -no-color'
                }
            }
        }

        stage('Apply') {
            agent {
                docker {
                    image 'alpine'
                }
            }
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve -no-color'
                }
            }
        }
    }
}