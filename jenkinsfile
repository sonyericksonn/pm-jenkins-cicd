pipeline {
    agent any

    environment {
        PM_API_TOKEN_ID = credentials('pm-api-token-id')
        PM_API_TOKEN_SECRET = credentials('pm-api-token-secret')
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {
        stage('Init') {
            steps {
                dir('terraform') {
                    sh '''
                        docker run --rm \
                          -e AWS_ACCESS_KEY_ID \
                         -e AWS_SECRET_ACCESS_KEY \
                          -e PM_API_TOKEN_ID \
                          -e PM_API_TOKEN_SECRET \
                          -v /home/russo/.ssh:/home/russo/.ssh:ro \
                          -v "/var/jenkins_home/workspace/ks8 on-primesses/terraform:/workspace" \
                          -v "$(pwd)":/workspace \
                          -w /workspace \
                          hashicorp/terraform:1.9.8 init -reconfigure -no-color
                
                '''
                }
            }
        }
    



       stage('Plan') {
            steps {
                dir('terraform') {
                    sh '''
                        docker run --rm \
                          -e AWS_ACCESS_KEY_ID \
                          -e AWS_SECRET_ACCESS_KEY \
                          -e PM_API_TOKEN_ID \
                          -e PM_API_TOKEN_SECRET \
                          -v /home/russo/.ssh:/home/russo/.ssh:ro \
                          -v "/var/jenkins_home/workspace/ks8 on-primesses/terraform:/workspace" \
                          -v "$(pwd)":/workspace \
                          -w /workspace \
                          hashicorp/terraform:1.9.8 plan -no-color
                    '''
                }
            }
        }

        stage('Aprovacao Manual') {
            steps {
                input message: 'Deseja aplicar as alterações?', ok: 'Sim, aplicar'
            }
        }

        stage('Apply') {
            steps {
                dir('terraform') {
                    sh '''
                        docker run --rm \
                          -e AWS_ACCESS_KEY_ID \
                          -e AWS_SECRET_ACCESS_KEY \
                          -e PM_API_TOKEN_ID \
                          -e PM_API_TOKEN_SECRET \
                          -v /home/russo/.ssh:/home/russo/.ssh:ro \
                          -v "/var/jenkins_home/workspace/ks8 on-primesses/terraform:/workspace" \ 
                          -v "$(pwd)":/workspace \
                          -w /workspace \
                          hashicorp/terraform:1.9.8 apply -auto-approve -no-color
                    '''
                }
            }
        }
    }
}
