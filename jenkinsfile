pipeline {
    agent any

    environment {
        PM_API_TOKEN_ID       = credentials('pm-api-token-id')
        PM_API_TOKEN_SECRET   = credentials('pm-api-token-secret')
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        JENKINS_PUB_KEY       = credentials('jenkins-pub-key')
    }
    parameters {
        choice(
            name: 'CREATE_OR_DESTROY',
            choices: ['create', 'destroy'], 
            description: 'Would you like to create or destroy the infrastructure?'
        ) 
       }
    stages {
        stage('Authentication') {
            agent {
                docker {
                    image 'alpine'
                }
            }
            steps {
                dir('terraform') {
                    withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-private-key', keyFileVariable: 'JENKINS_PRIVATE_KEY')]) {
                        sh '''
                            cp "$JENKINS_PRIVATE_KEY" id_rsa
                            echo "$JENKINS_PUB_KEY" > id_rsa.pub
                            chmod 600 id_rsa
                        '''
                    }
                }
            }
        }   
        
        stage('Init') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.9.8'
                    args '-u 0:0 --entrypoint=""'
                }
            }
            steps {
                dir('terraform') {
                    sh 'terraform init -reconfigure -no-color'
                }
            }
        }   
        
        stage('Plan') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.9.8'
                    args '-u 0:0 --entrypoint=""'
                }
            }
            steps {
                dir('terraform') {
                    sh '''
                        terraform init -reconfigure -no-color
                        terraform plan -no-color
                    '''
                }
            }
            when {
                expression { params.CREATE_OR_DESTROY == 'create' }
            }
        }

        stage('Apply') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.9.8'
                    args '-u 0:0 --entrypoint=""'
                }
            }
            steps {
                dir('terraform') {
                    withCredentials([sshUserPrivateKey(credentialsId: 'jenkins-private-key', keyFileVariable: 'JENKINS_PRIVATE_KEY')]) {
                        sh '''
                            cp "$JENKINS_PRIVATE_KEY" id_rsa
                            chmod 600 id_rsa
                            terraform init -reconfigure -no-color
                            terraform apply -auto-approve -no-color
                     '''
                    }
                }
            }
            when {
                expression { params.CREATE_OR_DESTROY == 'create' }
            }
        }
        stage('Destroy') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.9.8'
                    args '-u 0:0 --entrypoint=""'
                }
            }
            steps {
                dir('terraform') {
                    sh '''
                        terraform init -reconfigure -no-color
                        terraform apply -destroy -auto-approve -no-color
                    '''
                }
            }
            when {
                expression { params.CREATE_OR_DESTROY == 'destroy' }

            }
        }
    }
}