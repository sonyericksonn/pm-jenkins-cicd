pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('minio-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('minio-secret-access-key')
    }

    stages {
        stage('Init') {
            steps {
                sh '''
                    docker run --rm \
                      -e AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
                      -e AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
                      -v "$(pwd)":/workspace \
                      -w /workspace \
                      hashicorp/terraform:1.9.8 init -no-color
                '''
            }
        }
    }
}